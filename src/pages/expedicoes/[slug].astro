---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ItineraryTimeline from '../../components/ItineraryTimeline.astro';
import InclusionsList from '../../components/InclusionsList.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { whatsappLink } from '../../config/site';
import { formatDateRangeLong } from '../../lib/dates';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const expeditions = await getCollection('expeditions');
  return expeditions.map((expedition) => ({
    params: { slug: expedition.id },
    props: { expedition },
  }));
}

const { expedition } = Astro.props;
const e = expedition.data;
const { Content } = await render(expedition);

const priceFormatted = e.priceFrom
  ? new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL',
      maximumFractionDigits: 0,
    }).format(e.priceFrom)
  : null;

const backHref = `${withBase('/')}#expedicoes`;

// Gera uma versão 1200x630 da própria capa pra usar como preview ao
// compartilhar o link da expedição (em vez da imagem genérica do site).
const ogImage = await getImage({ src: e.cover, width: 1200, height: 630, quality: 75 });
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();

const ctaLink = whatsappLink(
  e.whatsappMessage ?? `Olá! Tenho interesse na expedição "${e.title}". Pode me passar mais detalhes?`
);
---

<Layout title={e.title} description={e.subtitle} image={ogImageUrl}>
  <Header />

  <section class="relative">
    <div class="relative aspect-[16/9] w-full overflow-hidden bg-sand sm:aspect-[21/9]">
      <Image
        src={e.cover}
        alt={e.title}
        width={1400}
        widths={[640, 1080, 1400]}
        sizes="100vw"
        quality={75}
        layout="full-width"
        class={`h-full w-full object-cover ${e.esgotado ? 'grayscale' : ''}`}
      />
      {e.esgotado && (
        <div class="absolute inset-0 flex items-center justify-center bg-ink/35">
          <span class="rounded-full bg-ink px-5 py-2 font-mono text-sm font-semibold uppercase tracking-wider text-parchment">
            Esgotado
          </span>
        </div>
      )}
    </div>
    <div class="contour-divider"></div>
  </section>

  <section class="mx-auto max-w-content px-5 py-14 sm:px-8">
    <a href={backHref} class="text-sm text-stone hover:text-ink">← Voltar ao catálogo</a>

    <div class="mt-6 flex flex-col gap-8 lg:flex-row lg:gap-16">
      <div class="flex-1">
        <p class="eyebrow mb-2">{e.location}{e.difficulty && ` · ${e.difficulty}`}</p>
        <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">{e.title}</h1>
        <p class="mt-3 max-w-xl text-base text-stone">{e.subtitle}</p>

        {e.highlights.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {e.highlights.map((h) => (
              <li class="rounded-full border border-sand bg-white/60 px-3 py-1 font-mono text-xs text-stone">
                {h}
              </li>
            ))}
          </ul>
        )}

        <div class="prose prose-sm mt-8 max-w-none prose-headings:font-display prose-headings:text-ink prose-p:text-stone prose-p:leading-relaxed">
          <Content />
        </div>

        {e.presentationUrl && (
          <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-sand bg-white/70 p-5 sm:flex-row sm:items-center sm:p-6">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-rust/10 text-rust">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <h3 class="font-display text-base font-semibold text-ink">Apresentação da Expedição</h3>
                <p class="mt-0.5 text-xs text-stone">Confira nosso material visual com informações da viagem.</p>
              </div>
            </div>
            <a
              href={e.presentationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-full border border-rust/40 bg-white px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-rust shadow-sm transition-all hover:bg-rust hover:text-parchment sm:w-auto"
            >
              Ver Apresentação
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        )}

        <div class="mt-12">
          <ItineraryTimeline itinerary={e.itinerary} />
        </div>

        <div class="mt-12">
          <InclusionsList includes={e.includes} excludes={e.excludes} />
        </div>
      </div>

      <aside class="h-fit rounded-2xl border border-sand bg-white/70 p-6 lg:sticky lg:top-24 lg:w-80">
        {priceFormatted ? (
          <>
            <p class="font-mono text-xs uppercase tracking-wide text-stone">a partir de</p>
            <p class="font-display text-3xl font-semibold text-ink">{priceFormatted}</p>
            {e.priceNote && <p class="text-sm text-stone">{e.priceNote}</p>}
          </>
        ) : (
          <>
            <p class="font-mono text-xs uppercase tracking-wide text-stone">investimento</p>
            <p class="font-display text-2xl font-semibold text-ink">Sob consulta</p>
            <p class="text-sm text-stone">{e.priceNote || 'Consulte valores e condições no WhatsApp'}</p>
          </>
        )}

        <dl class="mt-5 space-y-2 border-t border-sand pt-4 text-sm">
          <div class="flex justify-between">
            <dt class="text-stone">Duração</dt>
            <dd class="font-medium text-ink">{e.durationDays} {e.durationDays === 1 ? 'dia' : 'dias'}</dd>
          </div>
          {e.groupSize && (
            <div class="flex justify-between">
              <dt class="text-stone">Grupo</dt>
              <dd class="font-medium text-ink">{e.groupSize}</dd>
            </div>
          )}
          {e.difficulty && (
            <div class="flex justify-between">
              <dt class="text-stone">Dificuldade</dt>
              <dd class="font-medium text-ink">{e.difficulty}</dd>
            </div>
          )}
        </dl>

        <div class="mt-5 border-t border-sand pt-4">
          <p class="font-mono text-xs uppercase tracking-wide text-stone">Data da expedição</p>
          <p class="mt-1 text-sm font-medium text-ink">{formatDateRangeLong(e.date, e.endDate)}</p>
        </div>

        {e.esgotado ? (
          <p class="btn-whatsapp mt-6 w-full cursor-default justify-center !bg-stone/15 !text-stone hover:!bg-stone/15 hover:!translate-y-0">
            Esgotado
          </p>
        ) : (
          <a href={ctaLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp mt-6 w-full justify-center">
            {priceFormatted ? 'Reservar pelo WhatsApp' : 'Consultar pelo WhatsApp'}
          </a>
        )}

        {e.presentationUrl && (
          <a
            href={e.presentationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex w-full items-center justify-center gap-2 rounded-full border border-sand bg-white/80 px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-ink shadow-sm transition-all hover:border-rust hover:bg-white hover:text-rust"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rust" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            Ver Apresentação
          </a>
        )}
      </aside>
    </div>
  </section>

  <Footer />
  {!e.esgotado && (
    <WhatsAppFloat message={e.whatsappMessage ?? `Olá! Tenho interesse na expedição "${e.title}".`} />
  )}
</Layout>
